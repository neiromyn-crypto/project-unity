      - kind: walker
        front: 0
        count: 18
        start: 1
        interval: 1.3
      - kind: runner
        front: 2
        count: 6
        start: 8
        interval: 1.3
      - kind: brute
        front: 2
        count: 2
        start: 20
        interval: 9
    - title: "\u0422\u0440\u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F"
      advice: "\u0412\u0441\u0435 \u0432\u0445\u043E\u0434\u044B \u0430\u043A\u0442\u0438\u0432\u043D\u044B.
        \u041E\u0431\u0449\u0438\u0439 \u0440\u0443\u0431\u0435\u0436 \u0434\u043E\u043B\u0436\u0435\u043D
        \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u0431\u043E\u043A\u043E\u0432\u044B\u0435
