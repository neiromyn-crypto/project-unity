      damage: 12
      attackInterval: 1.5
      visualScale: 0.9
      physical: 1
      reward: 8
    waves:
    - title: "\u0417\u0430\u0449\u0438\u0442\u0438\u0442\u044C \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430"
      advice: "8 \u0431\u0440\u043E\u0434\u044F\u0433 \u0441 \u0441\u0435\u0432\u0435\u0440\u0430.
        \u041F\u0440\u0438\u043A\u0440\u043E\u0439\u0442\u0435 \u043F\u0443\u0442\u044C
        \u043A \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u043E\u043C\u0443 \u0443\u0437\u043B\u0443."
      groups:
      - kind: walker
        front: 0
        count: 8
        start: 1
        interval: 2.5
    - title: "\u0411\u044B\u0441\u0442\u0440\u044B\u0439 \u043F\u0440\u043E\u0440\u044B\u0432"
      advice: "\u0421\u0435\u0432\u0435\u0440 \u0438 \u0437\u0430\u043F\u0430\u0434:
        8 \u0431\u0440\u043E\u0434\u044F\u0433 \u0438 4 \u043A\u0438\u0431\u0435\u0440-\u0434\u0435\u043C\u043E\u043D\u0430."
      groups:
      - kind: walker
        front: 0
        count: 8
        start: 1
        interval: 2.5
      - kind: runner
        front: 1
        count: 4
        start: 12
        interval: 3
    - title: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u043A\u043E\u043D\u0442\u0430\u043A\u0442"
      advice: "8 \u0431\u0440\u043E\u0434\u044F\u0433, 4 \u043A\u0438\u0431\u0435\u0440-\u0434\u0435\u043C\u043E\u043D\u0430
        \u0438 1 \u0442\u043E\u043B\u0441\u0442\u044F\u043A \u0441 \u0432\u043E\u0441\u0442\u043E\u043A\u0430."
      groups:
      - kind: walker
        front: 0
        count: 8
        start: 1
        interval: 2.5
      - kind: runner
        front: 1
        count: 4
        start: 12
        interval: 3
      - kind: brute
        front: 2
        count: 1
        start: 24
        interval: 1.3
