    waves:
    - title: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0440\u0443\u0431\u0435\u0436"
      advice: "\u0421\u0435\u0432\u0435\u0440: \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435
        \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u0435 \u043E\u043F\u043E\u0440\u044B
        \u0431\u0430\u0440\u044C\u0435\u0440\u0430\u043C\u0438 \u0438 \u043F\u0440\u0438\u043A\u0440\u043E\u0439\u0442\u0435
        \u043F\u043E\u0432\u043E\u0440\u043E\u0442."
      groups:
      - kind: walker
        front: 0
        count: 14
        start: 1
        interval: 1.3
    - title: "\u0428\u043E\u0440\u043E\u0445 \u043D\u0430 \u0437\u0430\u043F\u0430\u0434\u0435"
      advice: "\u041D\u043E\u0432\u044B\u0439 \u0432\u0445\u043E\u0434 \u043D\u0430
        \u0437\u0430\u043F\u0430\u0434\u0435. \u0411\u0435\u0433\u0443\u043D\u044B
        \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442
        \u043F\u0440\u044F\u043C\u043E\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A."
      groups:
      - kind: walker
        front: 0
        count: 14
        start: 1
        interval: 1.3
      - kind: runner
        front: 1
        count: 8
        start: 9
        interval: 1.8
    - title: "\u0422\u044F\u0436\u0451\u043B\u044B\u0435 \u0448\u0430\u0433\u0438"
      advice: "\u0413\u0440\u043E\u043C\u0438\u043B\u044B \u0438\u0434\u0443\u0442
        \u0441 \u0432\u043E\u0441\u0442\u043E\u043A\u0430. \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435
        \u0441\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u0439
        \u0443\u0440\u043E\u043D."
